// CI-only overlay. All finance transitions use the production service runtime.
package billing

import (
	api "aster/billing/internal/financeapi"
	"aster/billing/internal/runtimeplugins"
	"encoding/json"
	"net/http/httptest"
	"os"
	"testing"
	"time"
)

func TestMySQLCommerceCloudModuleSmoke(t *testing.T) {
	if os.Getenv("GITHUB_ACTIONS") != "true" || os.Getenv("ASTER_MODULE_SMOKE_ROOT") == "" {
		t.Fatal("disposable module smoke required")
	}
	f := mysqlCatalogFixture(t)
	m := f.store.(*MySQL)
	runtime := NewServerModules06(runtimeplugins.New(os.Getenv("PLUGIN_DIRECTORY"), os.Getenv("PLUGIN_POLICY_FILE")))
	a := NewApp(m, Config{Demo: true, Origin: "http://localhost", Secret: ID() + ID(), CommerceContractVersion: "0.6", Services: runtime})
	if err := a.syncModuleSlots06(t.Context()); err != nil {
		t.Fatal(err)
	}
	connections, err := m.connections06(t.Context(), "mod-smoke")
	if err != nil || len(connections) != 1 {
		t.Fatal("approved connection absent", err)
	}
	if _, err = a.moduleDescription06(t.Context(), connections[0]); err != nil {
		t.Fatal(err)
	}
	input := product06Fixture(t, f)
	input.Slug = "module-smoke-" + ID()
	input.Module = &productModuleInput06{ModuleID: "server.aster-cloud", ConnectionID: "mod-smoke", Config: map[string]any{"preset_id": "smoke"}}
	p, err := m.SaveProduct06(t.Context(), f.admin, "", input, ID(), false)
	if err != nil {
		t.Fatal(err)
	}
	order, err := m.CreateOrder06(t.Context(), f.customer, quotedOrder06(t, m, f.customer, p, 1), ID())
	if err != nil {
		t.Fatal(err)
	}
	if _, err = m.AddInvoicePayment06(t.Context(), f.admin, order.Invoice.ID, invoice06Payment(order.Invoice.Total.AmountMinor, ID()), ID()); err != nil {
		t.Fatal(err)
	}
	var sid, tid string
	if err = m.DB.QueryRow("SELECT u.service_id,t.id FROM order_items i JOIN service_units u ON u.order_item_id=i.id JOIN service_tasks t ON t.service_id=u.service_id WHERE i.order_id=?", order.Order.ID).Scan(&sid, &tid); err != nil {
		t.Fatal(err)
	}
	if _, err = a.DispatchServiceTask06(t.Context(), tid, false, false); err != nil {
		t.Fatal(err)
	}
	complete := func(id string) {
		t.Helper()
		deadline := time.Now().Add(90 * time.Second)
		for time.Now().Before(deadline) {
			task, err := a.DispatchServiceTask06(t.Context(), id, true, false)
			if err == nil && task.Status == "succeeded" {
				return
			}
			if task.Status == "failed" {
				t.Fatal("module task failed", task)
			}
			time.Sleep(200 * time.Millisecond)
		}
		t.Fatal("module task did not complete", id)
	}
	complete(tid)
	view, err := m.Service06(t.Context(), f.customer.ID, sid)
	if err != nil || view.Status != "active" || view.ResourceID == nil || view.ModuleID == nil || *view.ModuleID != "server.aster-cloud" {
		t.Fatal("paid service not active", err)
	}
	resource := *view.ResourceID
	server := httptest.NewServer(a.Handler())
	defer server.Close()
	customer := client(t, server.URL, f.customer.Email, "CatalogFixture!2026")
	for _, action := range []string{"stop", "start"} {
		status, body := customer.request("POST", "/api/v1/services/"+sid+"/power", api.PowerServiceInput{Action: action}, ID())
		if status != 200 {
			t.Fatal(action, status, body)
		}
		complete(body["data"].(map[string]any)["id"].(string))
	}
	view, err = m.Service06(t.Context(), f.customer.ID, sid)
	if err != nil || view.ResourceID == nil || *view.ResourceID != resource || view.Status != "active" {
		t.Fatal("power cycle replaced allocation", err)
	}
	evidence, _ := json.Marshal(map[string]any{"paid_order": order.Order.ID, "service": sid, "module": "server.aster-cloud", "connection": "mod-smoke", "resource": resource, "active": true, "power_cycle": true})
	if err = os.WriteFile(os.Getenv("ASTER_MODULE_SMOKE_EVIDENCE"), evidence, 0600); err != nil {
		t.Fatal(err)
	}
}
