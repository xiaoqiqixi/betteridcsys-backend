# Copy to /etc/aster/api.env, root:aster, mode 0640. This is systemd EnvironmentFile
# syntax, not a shell script. Do not source it. Keep secret VALUES in separate files.
APP_MODE=production
# Replace with the exact canonical HTTPS origin: no trailing slash or path.
# This deployment value is independent of the administrator's display URL.
APP_ORIGIN=https://billing.example.com
LISTEN_ADDR=127.0.0.1:18080
# Nginx connects directly from this loopback address and overwrites client IP headers.
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# /etc/aster/secrets is root:aster 0750; these runtime files are root:aster 0640.
# Keep migration/bootstrap/backup credentials OUTSIDE this runtime-readable directory.
SESSION_SECRET_FILE=/etc/aster/secrets/session_secret
MYSQL_DSN_FILE=/etc/aster/secrets/mysql_runtime_dsn
# Safe default: DSN must use verified TLS (tls=true), without plaintext fallback.
# For an explicitly reviewed SAME-HOST MySQL Unix socket only, set this to true.
# The current backend also requires this exception for unix(/run/mysqld/mysqld.sock)
# because its TLS guard does not distinguish Unix sockets from TCP connections.
# Verify the DSN actually uses that Unix socket and its directory/permissions are
# controlled. Never enable this for a remote or public plaintext TCP connection.
MYSQL_ALLOW_INSECURE=false

# These are legacy registry defaults. Optional runtime payment/SMTP selection
# comes from the separately approved policy below, including its enabled flag.
PAYMENT_PROVIDER=payment.disabled
EMAIL_PROVIDER=email.disabled
# Optional independently installed payment/SMTP slots. Both paths must be root-controlled.
# Empty/unset paths leave the runtime plugin unavailable. Merely copying a
# package never starts or enables it; use plugin-manager.py and the corresponding
# aster-smtp.service or aster-payment.service after explicit approval.
PLUGIN_DIRECTORY=/opt/aster/plugins
PLUGIN_POLICY_FILE=/etc/aster/plugins.json
# /etc/aster must be root:root 0755 for the worker to read the public policy;
# api.env stays root:aster 0640 and secrets stays root:aster 0750.
# The policy contains only approvals, UID/socket metadata, non-secret merchant
# identity and destination limits. Payment credentials belong to its independent
# worker's protected configuration/systemd credentials, never this API file.
# Optional SMTP credential-encryption key: leave unset to keep sending unavailable.
# Exactly 32 RAW random bytes, no newline/hex/base64; regular file, no symlinks.
# Unlike the other runtime secrets above, use aster:aster 0400 (not group-readable).
# Keep parent directories root-controlled; retain ProtectSystem=strict in the unit.
# Generate once, protect and back up separately from the database; never overwrite
# an existing key. See docs/INSTALL.md and docs/BACKUP_RECOVERY.md before enabling.
# SMTP_ENCRYPTION_KEY_FILE=/etc/aster/secrets/smtp_encryption_key

# Optional read-only credential for this fixed official project's private releases.
# Provided by an authorized secret manager, never entered in the browser or CLI
# arguments. Exact aster:aster 0400, regular single-link file, protected parents.
# Without repository read access an explicit update check reports unavailable.
# UPDATE_RELEASE_TOKEN_FILE=/etc/aster/secrets/github_release_read_token

# Optional read-only receipt published by the explicit root host executor.
# Root-owned regular file and protected ancestors; never a writable web job queue.
# Missing/unconfigured/unreadable receipts appear distinctly in the admin UI.
# Keep the public export outside the executor's private state/config/release roots.
# HOST_OPERATION_STATUS_FILE=/var/lib/aster-status/operation.json
