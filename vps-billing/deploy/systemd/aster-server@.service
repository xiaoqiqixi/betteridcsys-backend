[Unit]
Description=Aster server connection %i
Documentation=file:/opt/aster/current/docs/SERVER_MODULES.md
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/aster/plugins /etc/aster
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# A fixed non-login account, distinct from both the API and SMTP worker.
# This account must never join the API's aster group or read its secrets.
User=aster-srv-%i
Group=aster-plugins
WorkingDirectory=/opt/aster/plugins
# Verify administrator-approved identity, compatibility and hashes before exec.
# No API EnvironmentFile, database credential or SMTP credential is inherited.
# Each root-owned directory contains only this connection's credential files.
LoadCredential=server:/etc/aster/server/%i/
ExecStart=/opt/aster/current/bin/aster-plugin-host --kind server --slot %i --root /opt/aster/plugins --policy /etc/aster/plugins.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
RuntimeDirectory=aster-server/%i
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
StateDirectory=aster-server/%i
StateDirectoryMode=0700

ReadWritePaths=/run/aster-server/%i /var/lib/aster-server/%i
InaccessiblePaths=-/etc/aster/api.env -/etc/aster/secrets -/run/mysqld -/var/lib/mysql -/run/aster-smtp -/etc/aster/server -/etc/aster/payment -/run/aster-payment
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
LimitNOFILE=64
TasksMax=64
MemoryMax=192M
CPUQuota=50%

# Plugin output is untrusted and may contain callback data or channel secrets.
# systemd records the lifecycle without copying process payloads to journald.
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
