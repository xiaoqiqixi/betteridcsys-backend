    "sql": "SELECT p.id,p.slug,p.kind,r.type_id,n.region_id,p.node_id,p.name_i18n,p.description_i18n,p.badges,p.specs,p.stock,p.visibility,p.controller_id,p.remote_product_id,p.sort_order,p.revision,(n.enabled AND r.enabled AND t.enabled),COALESCE(service_counts.active_services,0) FROM products p JOIN catalog_nodes n ON n.id=p.node_id JOIN catalog_regions r ON r.id=n.region_id JOIN catalog_types t ON t.id=r.type_id LEFT JOIN (SELECT product_id,COUNT(*) active_services FROM services WHERE status NOT IN ('terminated','cancelled') GROUP BY product_id) service_counts ON service_counts.product_id=p.id ORDER BY p.sort_order,p.id"
